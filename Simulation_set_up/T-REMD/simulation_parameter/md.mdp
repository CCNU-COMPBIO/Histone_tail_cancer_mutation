; md.mdp 
integrator               = md                
nsteps                   = 110000000        
dt                       = 0.002              
nstxout-compressed       = 5000      
nstxout                  = 0                     
nstvout                  = 0                 
nstfout                  = 0                  
nstenergy                = 5000          
nstlog                   = 5000      
continuation             = yes               
constraint_algorithm     = lincs            
constraints              = h-bonds        
lincs_iter               = 1                   
lincs_order              = 4                  
cutoff-scheme            = Verlet     
ns_type                  = grid              
nstlist                  = 20           
rcoulomb                 = 1.0               
rvdw                     = 1.0             
rvdw-switch              = 0.95     
rlist                    = 1.0      
coulombtype              = PME               
pme_order                = 4                    
fourierspacing           = 0.16              
tcoupl                   = V-rescale                   
tc-grps                  = System       
tau_t                    = 1                         
ref_t                    = target-TEMP                         
pcoupl                   = Parrinello-Rahman           
pcoupltype               = isotropic                   
tau_p                    = 1.0                            
ref_p                    = 1.0                           
compressibility          = 4.5e-5                  
pbc                      = xyz               
DispCorr                 = EnerPres       
gen_vel                  =no             
