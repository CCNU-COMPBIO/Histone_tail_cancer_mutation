; nvt.mdp               
define                   = -DPOSRES
integrator               = md
dt                       = 0.002         
nsteps                   = 300000         
nstlog                   = 1000
nstenergy                = 1000
nstxout-compressed       = 10000
compressed-x-precision   = 1000
cutoff-scheme            = Verlet
nstlist                  = 10
ns-type                  = Grid
pbc                      = xyz
verlet-buffer-tolerance  = 0.005
rlist                    = 1.0
coulombtype              = PME
rcoulomb                 = 1.0
rvdw                     = 1.0
DispCorr                 = EnerPres
fourierspacing           = 0.12
pme-order                = 4
ewald-rtol               = 1e-05
constraints              = all-bonds
constraint_algorithm     = LINCS
continuation             = no
lincs-order              = 4
lincs-iter               = 1
tcoupl                   = v-rescale
tc-grps                  = System
tau-t                    = 1
ref-t                    = 310           
annealing                = single
annealing_npoints        = 3             
annealing_time           = 0     400    600   
annealing_temp           = 50    target-TEMP    target-TEMP  
pcoupl                   = no
gen-vel                  = yes
gen-temp                 = 50
gen-seed                 = -1   
