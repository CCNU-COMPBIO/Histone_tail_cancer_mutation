; npt.mdp
integrator               = md 
nsteps                   = 1250000  
dt                       = 0.004
nstxout                  = 500000
nstvout                  = 500000
nstfout                  = 500000
nstlog                   = 1000
nstenergy                = 1000
nstxout-compressed       = 10000  
compressed-x-precision   = 1000 
cutoff-scheme            = Verlet
nstlist                  = 10
ns_type                  = grid
pbc                      = xyz
verlet-buffer-tolerance  = 0.005
rlist                    = 1.0
coulombtype              = PME
rcoulomb                 = 1.0
rvdw                     = 1.0
vdwtype                  = cutoff
DispCorr                 = EnerPres 
fourierspacing           = 0.12
pme-order                = 4
ewald-rtol               = 1e-05
constraints              = all-bonds
constraint_algorithm     = LINCS
continuation             = yes
lincs-order              = 4
lincs-iter               = 1 
gen-vel                  = no
gen-temp                 = 310
gen-seed                 = -1
tcoupl                   = v-rescale
tc-grps                  = System
tau-t                    = 1
ref-t                    = 310
pcoupl                   = Parrinello-Rahman
pcoupltype               = Isotropic
tau-p                    = 1
compressibility          = 4.5e-5 
ref-p                    = 1
refcoord-scaling         = com 
comm-mode                = Linear
nstcomm                  = 100
comm-grps                = System
